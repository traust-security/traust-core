{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.20.0",
          "rules": [
            {
              "id": "go/log-injection",
              "shortDescription": {
                "text": "Log injection"
              },
              "fullDescription": {
                "text": "User input written to log."
              },
              "help": {
                "text": "Sanitize before logging."
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-117"
                ],
                "security-severity": "7.8",
                "precision": "high"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "go/log-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Log entry from user input."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pkg/api/handler.go"
                },
                "region": {
                  "startLine": 42,
                  "endLine": 44
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "aa11"
          }
        },
        {
          "ruleId": "go/log-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Suppressed instance."
          },
          "suppressions": [
            {
              "kind": "external"
            }
          ],
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pkg/api/other.go"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
