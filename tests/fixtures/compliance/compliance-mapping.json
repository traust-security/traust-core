 "checks": [
  {
   "id": "chk-no-open-critical-dependency-vulns",
   "description": "the findings-db view of the target's repos contains no open, triage-confirmed critical dependency-CVE finding",
   "collector": "findings_db",
   "assertion": {
    "path": "open_critical_dependency_findings[*]",
    "operator": "absent"
   },
   "fixtures": "fixtures/chk-no-open-critical-dependency-vulns/"
  },
  {
   "id": "chk-no-confirmed-hardcoded-credentials",
   "description": "no open, triage-confirmed hardcoded-credential finding (CWE-798/321 class) in the target's repos",
   "collector": "findings_db",
   "assertion": {
    "path": "open_confirmed_hardcoded_credential_findings[*]",
    "operator": "absent"
   },
   "fixtures": "fixtures/chk-no-confirmed-hardcoded-credentials/"
  },
  {
   "id": "chk-encryption-at-rest",
   "description": "every in-scope inventory resource that persists data reports encryption at rest enabled",
   "collector": "cloud_inventory",
   "assertion": {
    "path": "resources[*].encryption_at_rest",
    "operator": "equals",
    "expected": true
   },
   "applies_when": {
    "path": "resources[*]",
    "operator": "exists"
   },
   "fixtures": "fixtures/chk-encryption-at-rest/"
  },
  {
   "id": "chk-region-allowlist",
   "description": "every in-scope inventory resource sits in a declared allowed region (sovereignty/residency)",
   "collector": "cloud_inventory",
   "assertion": {
    "path": "resources[*].region",
    "operator": "in",
    "expected": "param:allowed_data_regions"
   },
   "applies_when": {
    "path": "resources[*]",
    "operator": "exists"
   },
   "fixtures": "fixtures/chk-region-allowlist/"
  },
  {
   "id": "chk-no-pqc-tls-killswitch",
   "description": "no GODEBUG PQC-TLS killswitch (tlsmlkem=0/tlskyber=0) declared anywhere the crypto census scanned",
   "collector": "crypto_audit",
   "assertion": {
    "path": "facts[*].probe_id",
    "operator": "not_equals",
    "expected": "CRYPTO_GODEBUG_TLS_KILLSWITCH"
   },
   "applies_when": {
    "path": "facts[*]",
    "operator": "exists"
   },
   "fixtures": "fixtures/chk-no-pqc-tls-killswitch/"
  },
  {
   "id": "chk-no-privileged-workloads",
   "description": "no privileged container in the target's manifests (KHS-W01 fires zero times)",
   "collector": "scan_k8s_hardening",
   "assertion": {
    "path": "summary.KHS-W01",
    "operator": "absent"
   },
   "applies_when": {
    "path": "stats.k8s_docs",
    "operator": "gte",
    "expected": 1
   },
   "fixtures": "fixtures/chk-no-privileged-workloads/"
  },
  {
   "id": "chk-no-rbac-wildcards",
   "description": "no wildcard verbs/resources in RBAC rules (KHS-R01 fires zero times)",
   "collector": "scan_k8s_hardening",
   "assertion": {
    "path": "summary.KHS-R01",
    "operator": "absent"
   },
   "applies_when": {
    "path": "stats.k8s_docs",
    "operator": "gte",
    "expected": 1
   },
   "fixtures": "fixtures/chk-no-rbac-wildcards/"
  },
  {
   "id": "chk-no-privilege-escalation",
   "description": "allowPrivilegeEscalation disabled everywhere (KHS-W02 fires zero times)",
   "collector": "scan_k8s_hardening",
   "assertion": {
    "path": "summary.KHS-W02",
    "operator": "absent"
   },
   "applies_when": {
    "path": "stats.k8s_docs",
    "operator": "gte",
    "expected": 1
   },
   "fixtures": "fixtures/chk-no-privilege-escalation/"
  },
  {
   "id": "chk-no-secrets-in-env",
   "description": "no secret exposed via container environment variable (KHS-W13 fires zero times)",
   "collector": "scan_k8s_hardening",
   "assertion": {
    "path": "summary.KHS-W13",
    "operator": "absent"
   },
   "applies_when": {
    "path": "stats.k8s_docs",
    "operator": "gte",
    "expected": 1
   },
   "fixtures": "fixtures/chk-no-secrets-in-env/"
  }
 ]
